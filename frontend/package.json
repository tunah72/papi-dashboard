{
  "name": "papi-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "NODE_OPTIONS=--localstorage-file=/tmp/papi-dashboard-vitest-localstorage vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "plotly.js": "^3.7.0",
    "plotly.js-geo-dist-min": "^2.35.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/plotly.js": "^2.35.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.6.1",
    "@playwright/test": "^1.50.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
