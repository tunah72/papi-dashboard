# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/

# Notebook
.ipynb_checkpoints/

# macOS
.DS_Store

# Excel lock files
~$*

# Streamlit secrets (API key của LLM)
.streamlit/secrets.toml

# Logs sinh ra lúc chạy AI module (giữ thư mục, bỏ nội dung)
logs/*
!logs/.gitkeep

# Frontend generated dependencies and verification artifacts
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vitest-localstorage*
frontend/node_modules/.tmp/
frontend/*.tsbuildinfo
